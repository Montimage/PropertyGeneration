<beginning>

<!--
Operator-refined CTI monitoring property.

Scenario: NG Setup storm targeting the AMF.

Detect two NGSetupRequest messages sent from the
same gNB to the same AMF within five seconds.
-->

<property
    value="THEN"
    delay_units="ms"
    delay_min="0"
    delay_max="5000"
    property_id="103"
    type_property="ATTACK"
    description="Detect repeated NG Setup requests from the same gNB to the same AMF within five seconds">

    <event
        value="COMPUTE"
        event_id="1"
        description="Initial NG Setup request observed on the N2 interface"
        boolean_expression="((ngap.procedure_code == 21) &amp;&amp;
                             (ngap.pdu_present == 1) &amp;&amp;
                             (sctp.dest_port == 38412) &amp;&amp;
                             (ip.src != ip.dst))"/>

    <event
        value="COMPUTE"
        event_id="2"
        description="Repeated NG Setup request from the same gNB to the same AMF"
        boolean_expression="((ngap.procedure_code == 21) &amp;&amp;
                             (ngap.pdu_present == 1) &amp;&amp;
                             (sctp.dest_port == 38412) &amp;&amp;
                             (ip.src == ip.src.1) &amp;&amp;
                             (ip.dst == ip.dst.1))"/>

</property>

</beginning>