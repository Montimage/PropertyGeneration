<beginning>
<!-- Property 1: NG Setup Storm targeting the AMF -->
<property value="THEN" delay_units="s" delay_min="0" delay_max="0" property_id="1" type_property="ATTACK"
    description="Detect NG Setup storm targeting the AMF">
    <event value="COMPUTE" event_id="1"
           description="NG Setup Request messages received rapidly"
           boolean_expression="(ngap.ng_setup_request.count &gt; 5)"/>
    <event value="COMPUTE" event_id="2"
           description="NG Setup Request messages within a short time interval"
           boolean_expression="(mmt_time_since(ngap.ng_setup_request.first_seen) &lt; 5)"/>
</property>
</beginning>