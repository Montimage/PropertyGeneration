<beginning>
<!-- Property: NG Setup Storm targeting the AMF -->
<property value="THEN" delay_units="ms" delay_min="0" delay_max="500" property_id="1001" type_property="ATTACK" description="NG Setup Storm targeting the AMF">
    <operator value="THEN" delay_units="ms" delay_min="0" delay_max="500">
        <event value="COMPUTE" event_id="1" description="NGSetupRequest message received" boolean_expression="ngap.message_type == 'NGSetupRequest'"/>
        <event value="COMPUTE" event_id="2" description="NGSetupRequest message received within a short time interval" boolean_expression="mmt_time_since(ngap.timestamp) &lt; 1000"/>
    </operator>
</property>
</beginning>