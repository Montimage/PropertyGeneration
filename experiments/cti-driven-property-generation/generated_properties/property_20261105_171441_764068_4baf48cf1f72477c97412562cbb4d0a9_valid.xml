<beginning>
<!-- Property 1: NG Setup Storm targeting the AMF -->
<property value="THEN" delay_units="ms" delay_min="0+" delay_max="500" property_id="1" type_property="ATTACK"
    description="Detects a NG Setup storm targeting the AMF - Repeated NGSetupRequest messages from a gNB to the AMF within a short time interval.">
    <event value="COMPUTE" event_id="1"
           description="First NGSetupRequest message"
           boolean_expression="mmt_lib.protocol_id == 296"/>  <!-- NGAP protocol ID -->
    <event value="COMPUTE" event_id="2"
           description="Subsequent NGSetupRequest messages within a short time window"
           boolean_expression="mmt_lib.protocol_id == 296 &amp;&amp; mmt_lib.time_delta &lt; 500"/>  <!-- NGAP protocol ID &amp;&amp; time delta less than 500ms -->
</property>
</beginning>