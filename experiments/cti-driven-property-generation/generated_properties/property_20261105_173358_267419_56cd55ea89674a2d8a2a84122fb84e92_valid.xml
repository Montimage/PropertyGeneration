<beginning>
<!-- Property 1: C4_NGAP_Setup_Storm : NG Setup storm targeting the AMF.-->
<property value="THEN" delay_units="s" delay_min="0" delay_max="0" property_id="1" type_property="ATTACK" 
    description="NG Setup storm targeting the AMF.">
      <event value="COMPUTE" event_id="1" 
             description="Repeated NGSetupRequest messages"
             boolean_expression="(ngap.ng_setup_request.count > 5)"/>
      <event value="COMPUTE" event_id="2" 
             description="Short time interval"
             boolean_expression="(time_delta &lt; 1)"/>
</property>
</beginning>