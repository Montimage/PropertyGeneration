<beginning>
<!-- Property 100: NG Setup Storm targeting the AMF -->
<property value="THEN" delay_units="s" delay_min="0+" delay_max="5" property_id="100" type_property="ATTACK"
    description="NG Setup storm targeting the AMF - Repeated NGSetupRequest messages from a gNB toward the AMF within a short time interval.">
    <operator value="THEN" delay_units="s" delay_min="0+" delay_max="5">
        <event value="COMPUTE" event_id="1"
               description="NGSetupRequest message received"
               boolean_expression="ngap.message_type == 'NGSetupRequest'"/>
        <event value="COMPUTE" event_id="2"
               description="Another NGSetupRequest message received within the time window"
               boolean_expression="(ngap.message_type == 'NGSetupRequest' &amp;&amp; (BASE.time_slot - BASE.time_slot.1) &lt; 5"/>
    </operator>
</property>
</beginning>