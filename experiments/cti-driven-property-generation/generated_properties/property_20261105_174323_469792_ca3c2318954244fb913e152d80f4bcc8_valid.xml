<beginning>
<!-- Property 1: CTI4BC_NGAP_NGSetupStorm : Detects NG Setup storm targeting the AMF -->

<property value="THEN" delay_units="ms" delay_min="0" delay_max="0" property_id="1" type_property="ATTACK"
    description="Detects repeated NGSetupRequest messages from a gNB toward the AMF within a short time interval.">
    <event value="COMPUTE" event_id="1"
            description="Trigger: Repeated NGSetupRequest messages"
            boolean_expression="(ngap.ng_setup_request_count &gt; 5)"/>
    <event value="COMPUTE" event_id="2"
            description="Context: N2 interface between gNB and AMF"
            boolean_expression="(base.protocol_id == 43)"/>
</property>
</beginning>