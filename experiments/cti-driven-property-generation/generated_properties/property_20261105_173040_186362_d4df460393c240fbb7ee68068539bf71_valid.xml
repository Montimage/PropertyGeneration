<beginning>
<!-- Property 1: NG Setup Storm Detection -->
<property value="THEN" delay_units="ms" delay_min="0" delay_max="100" property_id="1" type_property="ATTACK"
           description="Detects repeated NGSetupRequest messages targeting the AMF, indicating a NG Setup storm.">
    <event value="COMPUTE" event_id="1"
           description="NGSetupRequest message"
           boolean_expression="ngap.message_type == 13"/>
    <event value="COMPUTE" event_id="2"
           description="Multiple NGSetupRequest messages within a short time interval"
           boolean_expression="(count(ngap.message_type == 13) &gt; 5)"/>
</property>
</beginning>