<beginning>
<!-- Property 100: Detection of 5G NG Setup Storm targeting the AMF -->
<property value="THEN" delay_units="ms" delay_min="0" delay_max="0" property_id="100" type_property="ATTACK"
    description="Detection of 5G NG Setup storm targeting the AMF">
    <event value="COMPUTE" event_id="1"
           description="Repeated NGSetupRequest messages within a short time interval"
           boolean_expression="(count(ngap.ng_setup_request) > 5)"/>
    <event value="COMPUTE" event_id="2"
           description="NGSetupRequest messages directed towards the AMF"
           boolean_expression="((ngap.ng_setup_request.target_id == amf.id) &amp;&amp; (base.protocol_id == 137))"/>
</property>
</beginning>