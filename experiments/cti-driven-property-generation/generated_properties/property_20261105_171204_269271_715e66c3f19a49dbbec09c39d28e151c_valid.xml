<beginning>
<!-- Property 1: NG Setup Storm Detection -->
<property value="THEN" delay_units="ms" delay_min="0" delay_max="500" property_id="1" type_property="ATTACK" 
    description="Detects repeated NGSetupRequest messages from a gNB toward the AMF within a short time interval, indicative of a NG Setup storm targeting the AMF.">
    <event value="COMPUTE" event_id="1"
           description="NGSetupRequest message"
           boolean_expression="ngap.message_type == 10"/>
    <event value="COMPUTE" event_id="2"
           description="Rapidly repeated NGSetupRequest messages"
           boolean_expression="(mmt_count_events(1, 1, 500) > 5)"/>
</property>
</beginning>