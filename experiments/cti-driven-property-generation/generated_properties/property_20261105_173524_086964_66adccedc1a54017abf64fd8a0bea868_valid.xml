<beginning>
  <!--
  This rule detects repeated NGSetupRequest messages from a gNB toward the AMF, indicative of an NG Setup storm.
  The signature is:
  - IF:  We observe multiple NGSetupRequest messages within a short time window from the same gNB to the AMF.
  - THEN: This constitutes a potential NG Setup storm.
  -->

  <property value="THEN" delay_units="ms" delay_min="100" delay_max="500" property_id="101" type_property="ATTACK"
            description="Detects repeated NGSetupRequest messages from a gNB toward the AMF (NG Setup storm)">
    <event value="COMPUTE" event_id="1"
           description="NGSetupRequest message detected"
           boolean_expression="ngap.ng_setup_request"/>

    <event value="COMPUTE" event_id="2"
           description="Another NGSetupRequest message detected within the time window"
           boolean_expression="(#count(ngap.ng_setup_request, 100, 500) > 1)"/>
  </property>
</beginning>