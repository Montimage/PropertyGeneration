<beginning>
<!-- Property 1: NG Setup Storm Detection -->
<property value="THEN" delay_units="ms" delay_min="0" delay_max="500" property_id="1" type_property="ATTACK" 
    description="Detects repeated NGSetupRequest messages targeting the AMF, indicative of a NG Setup storm.">
    <event value="COMPUTE" event_id="1"
           description="NGSetupRequest Message"
           boolean_expression="mmt_lib.protocol_id == 0x002F"/>
    <event value="COMPUTE" event_id="2"
           description="Rapid Repetition of NGSetupRequest"
           boolean_expression="em_check_rapid_ngsetup_requests(1, 10)"/>
</property>
</beginning>