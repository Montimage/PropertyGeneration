<beginning>
<!-- Property 1: NG Setup Storm targeting the AMF -->
<property value="THEN" delay_units="ms" delay_min="0+" delay_max="100" property_id="1" type_property="ATTACK" 
    description="NG Setup storm targeting the AMF - Repeated NGSetupRequest messages from a gNB toward the AMF within a short time interval."
    >
    <operator value="THEN" delay_units="ms" delay_min="0+" delay_max="100">
      <event value="COMPUTE" event_id="1" 
             description="NGAP packet with NGSetupRequest message"
             boolean_expression="(ngap.message_type == 1)"/>
    </operator>
    <operator value="THEN" delay_units="ms" delay_min="0+" delay_max="100">
      <event value="COMPUTE" event_id="2" 
             description="Another NGAP packet with NGSetupRequest message within the defined time window"
             boolean_expression="((ngap.message_type == 1)&amp;&amp;((BASE.timestamp - event_id_1.timestamp) &lt; 100))"/>
    </operator>
    <operator value="THEN" delay_units="ms" delay_min="0+" delay_max="100">
      <event value="COMPUTE" event_id="3" 
             description="Yet another NGAP packet with NGSetupRequest message within the defined time window"
             boolean_expression="((ngap.message_type == 1)&amp;&amp;((BASE.timestamp - event_id_2.timestamp) &lt; 100))"/>
    </operator>
</property>
</beginning>