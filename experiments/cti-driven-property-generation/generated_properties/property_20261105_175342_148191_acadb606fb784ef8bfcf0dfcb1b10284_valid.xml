<beginning>
<!--
This rule detects a NG Setup storm targeting the AMF.
The signature is:
- IF: Repeated NGSetupRequest messages are sent from a gNB toward the AMF within a short time interval.
- THEN: The number of NGSetupRequest messages within a short time window exceeds a threshold.
-->

<property value="THEN" delay_units="ms" delay_min="0" delay_max="0" property_id="101" type_property="ATTACK"
          description="Detects a NG Setup storm targeting the AMF">
  <event value="COMPUTE" event_id="1"
         description="Check if NGSetupRequest messages are received"
         boolean_expression="(ngap.procedure_code == 10)"/>

  <event value="COMPUTE" event_id="2"
         description="Count the number of NGSetupRequest messages within a short time window"
         boolean_expression="(#count_ngap_setup_requests(1000)) &gt; 5"/>
</property>

</beginning>