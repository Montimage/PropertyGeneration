<beginning>
<!-- Property 1: NGAP_Setup_Storm_AMF : Detects repeated NGSetupRequest messages targeting the AMF -->
<property value="THEN" delay_units="ms" delay_min="100" delay_max="500" property_id="1" type_property="ATTACK"
    description="Detects repeated NGSetupRequest messages targeting the AMF, indicating a NG Setup storm.">
    <event value="COMPUTE" event_id="1"
           description="NGSetupRequest message received"
           boolean_expression="ngap.ng_setup_request"/>
    <event value="COMPUTE" event_id="2"
           description="Repeated NGSetupRequest messages within a short time interval"
           boolean_expression="count(ngap.ng_setup_request, 100, 500) &gt; 3"/>
</property>
</beginning>