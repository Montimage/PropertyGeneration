<beginning>
<!-- Property: Detects NG Setup Storm targeting the AMF -->
<!-- Description: This rule detects repeated NGSetupRequest messages from a gNB towards the AMF within a short time interval, indicating a potential NG Setup storm attack. -->
<property value="THEN" delay_units="ms" delay_min="0" delay_max="0" property_id="1001" type_property="ATTACK"
          description="Detects NG Setup Storm targeting the AMF">
  <event value="COMPUTE" event_id="1"
         description="NGSetupRequest message received"
         boolean_expression="ngap.ng_setup_request == TRUE"/>
  <event value="COMPUTE" event_id="2"
         description="Multiple NGSetupRequest messages within a short time window"
         boolean_expression="count(ngap.ng_setup_request) &gt; 5 WITHIN 1000 ms"/>
</property>
</beginning>