<beginning>
<!-- Property 1: NGAP_Setup_Storm_Detection : Detects repeated NGSetupRequest messages targeting the AMF -->
<property value="THEN" delay_units="ms" delay_min="100" delay_max="500" property_id="1" type_property="ATTACK"
    description="Detects repeated NGSetupRequest messages targeting the AMF within a short time interval.">
    <event value="COMPUTE" event_id="1"
           description="NGSetupRequest message received"
           boolean_expression="ngap.message_type == 'NGSetupRequest'"/>
    <event value="COMPUTE" event_id="2"
           description="Multiple NGSetupRequest messages within a short time window"
           boolean_expression="count(ngap.message_type == 'NGSetupRequest' within 100ms) &gt; 3"/>
</property>
</beginning>