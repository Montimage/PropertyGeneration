<beginning>
<!-- Property: NG Setup Storm targeting the AMF -->
<property value="THEN" delay_units="ms" delay_min="0+" delay_max="500" property_id="1001" type_property="ATTACK" description="NG Setup Storm targeting the AMF">
  <operator value="THEN" delay_units="ms" delay_min="0+" delay_max="500">
    <event value="COMPUTE" event_id="1" description="NGSetupRequest message received" boolean_expression="(base.protocol_id == 45)"/>
    <event value="COMPUTE" event_id="2" description="Subsequent NGSetupRequest received within a short time window" boolean_expression="(base.protocol_id == 45 &amp;&amp; (base.timestamp - base.timestamp.1 &lt; 500))"/>
  </operator>
</property>
</beginning>