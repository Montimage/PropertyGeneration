<beginning>
<!-- Property 100: NG Setup Storm targeting the AMF -->
<property value="THEN" delay_units="ms" delay_min="0+" delay_max="500" property_id="100" type_property="ATTACK"
    description="NG Setup Storm targeting the AMF - Repeated NGSetupRequest messages from a gNB to the AMF within a short time interval.">
    <operator value="THEN" delay_units="ms" delay_min="0+" delay_max="500">
        <event value="COMPUTE" event_id="1"
               description="NGSetupRequest message received."
               boolean_expression="base.protocol_id == 296"/>  <!-- Assuming 296 is the protocol ID for NGAP -->
        <event value="COMPUTE" event_id="2"
               description="Second NGSetupRequest message received within a short timeframe."
               boolean_expression="base.protocol_id == 296 &amp;&amp; base.timestamp - event_timestamp_1 &lt; 1000"/> <!-- Assuming timestamp is available and comparing to the first event -->
    </operator>
    <operator value="THEN" delay_units="ms" delay_min="0+" delay_max="500">
        <event value="COMPUTE" event_id="3"
               description="Third NGSetupRequest message received within a short timeframe."
               boolean_expression="base.protocol_id == 296 &amp;&amp; base.timestamp - event_timestamp_2 &lt; 1000"/>
        <event value="COMPUTE" event_id="4"
               description="Fourth NGSetupRequest message received within a short timeframe."
               boolean_expression="base.protocol_id == 296 &amp;&amp; base.timestamp - event_timestamp_3 &lt; 1000"/>
    </operator>
</property>
</beginning>