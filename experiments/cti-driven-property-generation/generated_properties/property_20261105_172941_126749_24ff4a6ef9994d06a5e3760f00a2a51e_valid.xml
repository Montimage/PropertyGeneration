<beginning>
  <property value="THEN" delay_units="ms" delay_min="0" delay_max="0" property_id="1001" type_property="ATTACK"
            description="Detect NG Setup storm targeting the AMF" >
    <event event_id="1" value="COMPUTE"
           description="NGAP message received"
           boolean_expression="ngap.protocol_id == 1"/>
    <event event_id="2" value="COMPUTE"
           description="Repeated NGSetupRequest messages"
           boolean_expression="(ngap.message_type == 1) &amp;&amp; (COUNT(ngap.message_type, 1, 500) > 5)"/>
  </property>
</beginning>