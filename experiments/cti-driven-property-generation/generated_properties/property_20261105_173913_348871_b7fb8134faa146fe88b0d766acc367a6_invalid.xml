<beginning>
<!-- Property: Detects NG Setup storm targeting the AMF -->
<property value="THEN" delay_units="s" delay_min="0" delay_max="1" property_id="1001" type_property="ATTACK" description="Detects repeated NGSetupRequest messages from a gNB toward the AMF within a short time interval.">
  <event value="COMPUTE" event_id="1" description="NGSetupRequest message received" boolean_expression="base.protocol_id == 296"/>
  <operator value="THEN" delay_units="s" delay_min="0" delay_max="0.5">
    <event value="COMPUTE" event_id="2" description="Another NGSetupRequest message received within a short time window" boolean_expression="base.protocol_id == 296 AND base.time_slot - base.time_slot.1 &lt; 0.5"/>
  </operator>
</property>
</beginning>