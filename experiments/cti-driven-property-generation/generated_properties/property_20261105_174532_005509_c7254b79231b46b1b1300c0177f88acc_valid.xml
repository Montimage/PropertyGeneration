<beginning>
<!-- Property 101: Detection of 5G NG Setup storm targeting the AMF -->
<property value="THEN" delay_units="ms" delay_min="0" delay_max="0" property_id="101" type_property="ATTACK"
    description="Detection of 5G NG Setup storm targeting the AMF">
    <event value="COMPUTE" event_id="1"
           description="NGSetupRequest messages within a short time interval"
           boolean_expression="(base.protocol_id == 458)"/>  <!-- Assuming 458 is the protocol ID for NGAP -->
    <event value="COMPUTE" event_id="2"
           description="Repeated NGSetupRequest messages"
           boolean_expression="(#count(base.protocol_id == 458, 500) > 10)"/> <!-- Check for more than 10 NGAP messages in 500ms -->
</property>
</beginning>