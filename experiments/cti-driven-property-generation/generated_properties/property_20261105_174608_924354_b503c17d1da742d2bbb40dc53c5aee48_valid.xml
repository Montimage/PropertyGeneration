<!-- Property: NG Setup Storm targeting the AMF -->
<property value="THEN" delay_units="ms" delay_min="0" delay_max="0" property_id="1001" type_property="ATTACK"
           description="NG Setup Storm targeting the AMF - Repeated NGSetupRequest messages">
  <event value="COMPUTE" event_id="1"
         description="Multiple NGSetupRequest messages within a short time interval"
         boolean_expression="count(ngap.NGSetupRequest) &gt; 3 within 500ms"/>
