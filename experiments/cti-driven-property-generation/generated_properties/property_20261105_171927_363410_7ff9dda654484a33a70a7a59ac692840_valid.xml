<beginning>
<!-- Property 1: CTI4BC - NG Setup Storm targeting the AMF -->
<property value="THEN" delay_units="ms" delay_min="0" delay_max="0" property_id="1" type_property="ATTACK"
    description="NG Setup storm targeting the AMF - Repeated NGSetupRequest messages from gNB to AMF within a short time interval.">
    <event value="COMPUTE" event_id="1"
        description="Trigger: Repeated NGSetupRequest messages"
        boolean_expression="(ngap.ng_setup_request &gt; 0)"/>
    <event value="COMPUTE" event_id="2"
        description="Context: NGAP over SCTP, N2 interface"
        boolean_expression="(ngap.sctp &amp;&amp; ngap.n2_interface)"/>
</property>
</beginning>